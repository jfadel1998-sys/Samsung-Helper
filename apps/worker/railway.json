{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile"
  },
  "deploy": {
    "startCommand": "pnpm db:migrate && pnpm --filter @hub/worker start",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
