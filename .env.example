# ─── Core ────────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when you attach Postgres.
DATABASE_URL=postgres://user:pass@host:5432/railway

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key: see docs/key-rotation.md — put the OLD key in
# TOKEN_ENCRYPTION_KEY_PREVIOUS, deploy, run the re-encrypt script, then clear it.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Public https origin of the web service. OAuth redirect URIs and webhook
# callback URLs are derived from this — it must match what you registered
# with Azure AD and Google exactly.
APP_BASE_URL=https://ops-hub.up.railway.app

# Single shared secret gating the entire web UI (§9 — single tenant, no auth SaaS).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HUB_ACCESS_TOKEN=

# Fallback owner addresses, comma separated. Each connected mailbox records its
# own owner addresses (accounts.owner_emails), which is what the prefilter
# actually uses — in Moet's mailbox, Moet is the owner. This is only consulted
# for accounts connected before that column existed.
OWNER_EMAILS=jason@traxtone.com

BRIEF_TIMEZONE=America/Los_Angeles

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Microsoft Graph (Outlook) ───────────────────────────────────────────────
# Azure AD app registration, single tenant.
# Scopes: Mail.Read offline_access User.Read
# Redirect URI: ${APP_BASE_URL}/api/auth/outlook/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Random secret echoed back by Graph in every webhook notification and
# validated on receipt (§9). Generate like HUB_ACCESS_TOKEN.
GRAPH_WEBHOOK_CLIENT_STATE=

# ─── Google (Gmail) ──────────────────────────────────────────────────────────
# See §2.1 — if this mailbox is on Google Workspace, register the OAuth consent
# screen as INTERNAL. A "Testing" app issues refresh tokens that die after 7 days.
# Scopes: https://www.googleapis.com/auth/gmail.readonly
# Redirect URI: ${APP_BASE_URL}/api/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pub/Sub topic that users.watch() publishes to, and the service account that
# signs the push JWTs we verify on /api/webhooks/gmail.
GOOGLE_PUBSUB_TOPIC=projects/my-project/topics/gmail-push
GOOGLE_PUBSUB_SERVICE_ACCOUNT=gmail-push@my-project.iam.gserviceaccount.com

# ─── Personal Gmail over IMAP ────────────────────────────────────────────────
# Nothing to configure. A personal @gmail.com cannot use the Internal Workspace
# escape hatch above, and OAuth for it means Google's CASA assessment, so those
# accounts connect with an app password at /connect/imap instead. The password
# is stored in the same encrypted vault as every OAuth token — it never appears
# here. See docs/imap-setup.md.

# ─── Brief delivery (M6, optional) ───────────────────────────────────────────
# Recipients are per-audience, in config/audiences.json. BRIEF_TO_ADDRESS is
# only a fallback for a single-audience setup.
RESEND_API_KEY=
BRIEF_FROM_ADDRESS=brief@traxtone.com
BRIEF_TO_ADDRESS=
